<Project Sdk="Godot.NET.Sdk/4.6.3">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- These live inside the repo but are their OWN projects; keep Godot's .cs glob out of them
         (otherwise their sources compile into the game assembly too -> duplicate types). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);MouseKombat.Sim/**;MouseKombat.Sim.Tests/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pure combat-logic library (no Godot dep), shared with the RL trainer. -->
    <ProjectReference Include="MouseKombat.Sim\MouseKombat.Sim.csproj" />
    <!-- In-game inference for trained RL policies (.onnx in ai_rl_model). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>
</Project>
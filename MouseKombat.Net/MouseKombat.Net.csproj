<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Networking + wire protocol. NO Godot dependency on purpose: sockets need none, so the room
         state machine and both ends of the transport are testable headlessly over loopback. That is
         the only way this layer gets verified at all, since the Godot side cannot be run here. -->
    <RootNamespace>MouseKombat.Net</RootNamespace>
    <AssemblyName>MouseKombat.Net</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shares CharacterId and the InputFrame shape with the sim; adds no third-party dependency to
         it (the sim must stay loadable bare by the pythonnet RL bridge). -->
    <ProjectReference Include="..\MouseKombat.Sim\MouseKombat.Sim.csproj" />
    <!-- Pinned exactly: the wire format is mirrored by hand in the Python lobby server
         (server/PROTOCOL is Net/PROTOCOL.md), so a serializer upgrade must be a deliberate,
         reviewed change on both sides rather than something a restore does quietly. -->
    <PackageReference Include="MessagePack" Version="[3.1.8]" />
    <!-- Rollback netcode (MIT). PINNED with [brackets] = exact version, never floating: Backdash has
         no stable release (60 previews, 0.5.x -> 0.7.x with breaking API changes), so an unpinned
         reference could silently move the project onto an incompatible API.
         It lives HERE rather than in the Godot project so RollbackMatch — the one file that touches
         it — can be driven headlessly by the test runner. MouseKombat.Sim still never sees it:
         GameSim.SaveState/LoadState is a plain Span<byte> contract, which is what keeps the sim
         loadable bare by the pythonnet RL bridge. -->
    <PackageReference Include="Backdash" Version="[0.7.8-preview]" />
  </ItemGroup>
</Project>
